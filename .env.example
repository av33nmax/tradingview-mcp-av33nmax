# ──────────────────────────────────────────────────────────────────────────
# Environment configuration — copy this to `.env.local` and fill in YOUR own
# values. The Next.js dashboards (dashboard/, asia/dashboard/) load
# `.env.local` by convention, and the node scripts inherit that env when the
# dashboard spawns them — so put your real values in each dashboard's
# `.env.local`. NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ─── Interactive Brokers (TWS / IB Gateway) ────────────────────────────────
# Host/port of your running TWS or IB Gateway. Use 127.0.0.1 if TWS runs on
# the same machine; set a LAN IP (e.g. 192.168.x.x) if it runs on another box.
IBKR_HOST=127.0.0.1
IBKR_PORT=7496              # 7496 live / 7497 paper (TWS); 4001/4002 (Gateway)

# IBKR Flex Web Service — optional, for trade-history import.
# Create at IBKR: Reports → Flex Queries → Flex Web Service.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_CONFIRM_QUERY_ID=

# ─── Discord alerts (optional) ──────────────────────────────────────────────
# Webhook URLs for trade/setup alerts. Leave blank to disable Discord.
DISCORD_WEBHOOK=
DISCORD_WEBHOOK_HSI=

# ─── Bitget (optional crypto module) ────────────────────────────────────────
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# ─── Watcher behavior (strategy tunables — set to your own preference) ───────
WATCHER_AUTO_FIRE=0            # 1 = auto-transmit orders, 0 = dry-run / manual
WATCHER_CONFIRM_FIRE=0         # 1 = require N-bar confirmation before firing
WATCHER_MAX_TRADES_PER_DAY=    # blank = no cap; set an integer to cap
WATCHER_STOP_USD=0.10          # fixed option-premium stop distance, US ($/share)
WATCHER_HK_STOP_PCT=15         # fixed stop %, HK
WATCHER_TRAILING_RUNNER=0      # 1 = enable trailing-runner exit (off by default)

# ─── Dashboards / misc ──────────────────────────────────────────────────────
DASHBOARD_BASE=http://localhost:3000
TEST_TICKER=SPY                # ticker used by some test scripts
# BACKTEST_DATA=/path/to/your/backtest/data   # only if you run backtests
